<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Pike.PythonClient.Test</AssemblyName>
    <RootNamespace>Pike.PythonClient.Test</RootNamespace>
    <IsPackable>false</IsPackable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="2.2.10" />
    <PackageReference Include="MSTest.TestFramework" Version="2.2.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pike.PythonClient64\Pike.PythonClient64.csproj" />
    <ProjectReference Include="..\Pike.PythonClient64.Install\Pike.PythonClient64.Install.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Data" />
    <Reference Include="System.Xml" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Python\*.py" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Keeps the provider record of the copied app.config in sync with the assembly version of this build: without it
       DbProviderFactories.GetFactory would resolve the provider from the GAC (Release 2.0.0.0) instead of the
       assembly that was just built, see Directory.Build.props -->
  <Target Name="PatchProviderVersionInTestConfig" AfterTargets="Build"
          Condition="Exists('$(OutDir)$(TargetFileName).config')">
    <XmlPoke XmlInputPath="$(OutDir)$(TargetFileName).config"
             Query="/configuration/system.data/DbProviderFactories/add/@type"
             Value="Pike.PythonClient64.Data.PythonProviderFactory, Pike.PythonClient64, Version=$(AssemblyVersion), Culture=neutral, PublicKeyToken=8c0beba75960bb80" />
  </Target>

</Project>
