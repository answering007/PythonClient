<?xml version='1.0' encoding='utf-8'?>
<SettingsFile xmlns="http://schemas.microsoft.com/VisualStudio/2004/01/settings" CurrentProfile="(Default)" GeneratedClassNamespace="Pike.PythonClient.Test" GeneratedClassName="SettingsMain">
  <Profiles />
  <Settings>
    <!-- Python runtime path is configured by the PYTHONNET_TEST_DLL environment variable.
         The values below are fallbacks and are empty by default -->
    <Setting Name="PythonDllPath" Type="System.String" Scope="Application">
      <Value Profile="(Default)"></Value>
    </Setting>
    <Setting Name="EnvPythonDllPath" Type="System.String" Scope="Application">
      <Value Profile="(Default)"></Value>
    </Setting>
    <Setting Name="PythonScriptsFolder" Type="System.String" Scope="User">
      <Value Profile="(Default)">Python</Value>
    </Setting>
  </Settings>
</SettingsFile>